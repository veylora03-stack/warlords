# =============================================================================
# WARLORDS — environment template (Phase 26)
# -----------------------------------------------------------------------------
# Copy to `.env` and fill. NEVER commit the filled file — `.env*` is
# gitignored, and production secrets live ONLY in the deployment platform's
# secret store (Render/Railway/Koyeb env groups, Supabase, Docker secrets).
# `bun run dev` needs only DATABASE_URL; production requires the fields
# marked REQUIRED-IN-PROD (the server refuses to boot without them).
# =============================================================================

# ── Core ─────────────────────────────────────────────────────────────────────

# Database connection string. REQUIRED (always).
#   Sandbox/dev (SQLite):   file:./db/custom.db
#   Production (Supabase):  postgresql://postgres:<PASSWORD>@db.<PROJECT-REF>.supabase.co:5432/postgres?connection_limit=40&pool_timeout=10
#   Supabase pooled runtime (pgBouncer, port 6543): same but :6543 and &pgbouncer=true
#   Migration jobs must use the DIRECT connection (5432), not the pooled one.
DATABASE_URL=

# Runtime environment: development | test | production. The platform sets
# this; set it explicitly in Docker.
NODE_ENV=development

# Structured logger threshold (src/lib/logger): debug | info | warn | error.
# Production default is `info`; query-level logging is automatically disabled
# in production regardless of this value.
LOG_LEVEL=info

# HTTP port + bind address of the standalone production server.
# Containers MUST keep HOSTNAME=0.0.0.0 (the platform router cannot reach loopback).
PORT=3000
HOSTNAME=0.0.0.0

# ── Public URLs ──────────────────────────────────────────────────────────────

# Public HTTPS base URL of the deployment. REQUIRED-IN-PROD.
# Used for: Telegram webhook registration, Mini App (menu button + play
# buttons), bot deep links. Telegram webhooks require a valid TLS certificate.
# APP_URL=https://warlords.example.com
APP_URL=

# ── Auth / sessions ──────────────────────────────────────────────────────────

# Session JWT signing secret (≥32 chars). REQUIRED-IN-PROD.
# Generate: openssl rand -hex 32
JWT_SECRET=

# Server-side session lifetime in seconds (default 7 days).
SESSION_TTL_SECONDS=604800

# Max age of Telegram initData `auth_date` before replay rejection (seconds).
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400

# ── Telegram bot ─────────────────────────────────────────────────────────────

# Bot token from @BotFather. REQUIRED-IN-PROD.
TELEGRAM_BOT_TOKEN=

# Webhook shared secret — Telegram sends it in X-Telegram-Bot-Api-Secret-Token
# on every update; the server constant-time-compares it. REQUIRED-IN-PROD.
# Must be 1–256 chars of [A-Za-z0-9_-]. Generate: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# ── Admin console ────────────────────────────────────────────────────────────

# Admin console secret (Phase 21 admin auth context).
ADMIN_SECRET=

# Comma-separated Telegram user ids allowed to administer the game.
# ADMIN_TELEGRAM_IDS=123456789,987654321
ADMIN_TELEGRAM_IDS=

# ── Container ops (read by docker/docker-entrypoint.sh) ─────────────────────

# true → the container entrypoint runs `prisma migrate deploy` against the
# PostgreSQL schema (prisma/postgres/) before booting the server.
# On Render/Koyeb/Railway you can instead run the same command as a
# pre-deploy step. Keep false when the platform handles migrations.
RUN_MIGRATIONS=false

# Ops kill-switch for the background notification-queue worker of THIS process.
# Set true when a dedicated worker instance drains the queue (multi-instance
# deployments) or when a dev/QA server must not compete with direct-drain tests.
NOTIFICATION_WORKER_DISABLED=false
